{
  "name": "frontend-study-lab",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev-wait": "wait-on tcp:5433 http-get://localhost:8000/health && pnpm run dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint --config frontend/eslint.config.mjs frontend/",
    "lint:fix": "eslint --config frontend/eslint.config.mjs frontend/ --fix",
    "test": "vitest --config frontend/vitest.config.ts",
    "test:run": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "prepare": "husky",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify/vue": "^5.0.4",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "sass": "^1.105.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,vue}": [
      "eslint --config frontend/eslint.config.mjs --fix"
    ],
    "frontend/**/*.{md,json,scss,css}": [
      "eslint --config frontend/eslint.config.mjs --fix"
    ]
  },
  "msw": {
    "workerDirectory": [
      "frontend/public"
    ]
  }
}
